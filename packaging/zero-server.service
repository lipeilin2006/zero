# 示例 unit：专用用户 zero + /var/lib/zero-server 的写法。
# 一键脚本会按「执行 sudo 的当前用户 + ~/.local/share/zero-server」生成，
# 需要专用用户时用：install-server.sh --user zero --data-dir /var/lib/zero-server
[Unit]
Description=Zero remote shell server (iroh)
Documentation=https://github.com/lipeilin2006/zero
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zero
Group=zero
ExecStart=/usr/local/bin/zero-server run --key /var/lib/zero-server/secret.key --allowlist /var/lib/zero-server/authorized_keys
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/zero-server
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

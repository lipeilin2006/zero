# 示例 unit：默认的专用用户 zero + /var/lib/zero-server 写法。
# 一键脚本生成的 unit 与这个一致（可改 --user / --data-dir）。
[Unit]
Description=Zero remote shell server (iroh)
Documentation=https://github.com/lipeilin2006/zero
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zero
Group=zero
WorkingDirectory=/var/lib/zero-server
Environment=HOME=/var/lib/zero-server
ExecStart=/usr/local/bin/zero-server run --key /var/lib/zero-server/secret.key --allowlist /var/lib/zero-server/authorized_keys
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/zero-server
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
